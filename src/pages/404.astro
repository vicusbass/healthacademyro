---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Pagina nu a fost găsită | Health Academy"
  description="Pagina căutată nu există sau a fost mutată."
  noindex
>
  <main>
    <section class="py-20 md:py-32">
      <div class="container-custom text-center">
        <h1 class="text-9xl font-bold text-primary-600 dark:text-primary-400 mb-8">404</h1>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">Pagina nu a fost găsită</h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
          Pagina pe care o cauți nu există, a fost mutată sau este temporar indisponibilă.
        </p>
        <div class="flex justify-center gap-4 flex-wrap">
          <a href="/" class="btn-primary">
            Înapoi la pagina principală
          </a>
          <a href="/contact/" class="btn-secondary">
            Contactează-ne
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
