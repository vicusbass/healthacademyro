---
const site = Astro.site;
const organizationId = new URL('/#organization', site).href;

const data = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['MedicalClinic', 'Physiotherapy'],
      '@id': organizationId,
      name: 'Health Academy',
      description: 'Centru de recuperare medicală, kinetoterapie, fizioterapie și ortopedie în Cluj-Napoca.',
      url: new URL('/', site).href,
      logo: new URL('/android-chrome-512x512.png', site).href,
      image: new URL('/og-image.jpg', site).href,
      telephone: '+40745552555',
      email: 'healthacademy.cluj@gmail.com',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Strada Fagului 34',
        postalCode: '400483',
        addressLocality: 'Cluj-Napoca',
        addressRegion: 'Cluj',
        addressCountry: 'RO',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 46.7551029, longitude: 23.6142572 },
      hasMap: 'https://maps.app.goo.gl/pHjPJEpi4TJ617DB6',
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '20:00',
        },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '15:00' },
      ],
      areaServed: { '@type': 'City', name: 'Cluj-Napoca' },
      medicalSpecialty: ['Physiotherapy', 'Musculoskeletal'],
      sameAs: [
        'https://www.instagram.com/healthacademycluj',
        'https://www.tiktok.com/@healthacademycluj',
        'https://www.facebook.com/healthacademycluj',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', site).href,
      url: new URL('/', site).href,
      name: 'Health Academy',
      inLanguage: 'ro-RO',
      publisher: { '@id': organizationId },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
